__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.env
.env.*
!.env.example
credentials*.json
*token*.json
.config/
.colab-home/
.tools/
.bin/
# Model weights/checkpoints must be archived with hashes and a durable URI.
# Generated JSONL traces are deliberately NOT ignored.
runs/**/checkpoints/
*.safetensors
*.pt
*.pth
*.bin
*.gguf


# Raw 10k replay working copy is preserved byte-for-byte in the reviewed,
# bounded archives under data/native-cli-10k-v1/evidence/ (not deleted).
/data/luna-cli-v1/native_teacher_observed/batch_train_dev_10k_v1/
# Reviewed public tokenizer assets and non-secret token-count audit reports.
!data/**/tokenizer/tokenizer.json
!data/**/tokenizer/tokenizer_config.json
!data/**/tokenizer/special_tokens_map.json
!data/**/token_validation.json
!data/native-source-reviews/cli-10k-token-audit.json
# Immutable complete copies are in data/historical-native-pilots/*.tar.gz.
/data/native-pilot-v1/
/data/native-pilot-v2/
/data/native-pilot-v3/
/data/native-python-pilot-v1/

# Frozen raw/superseded outputs: every file is byte-exactly represented by
# data/historical-working-evidence-v1/files.jsonl and its pinned canonical
# references/archives. Originals remain on disk; use new versioned paths for new runs.
/data/luna-python-v1/native_teacher_observed.batch-v1/
/data/luna-knowledge-search-v1/native_teacher_observed.batch-v1/
/data/luna-knowledge-search-v1/native_teacher_observed.pilot-v1/
/data/native-python-10k-v1/
# Keep bulk pilot evidence archived, but expose the 18 exact journals read
# by the preserved-observation regression in a clean checkout.
